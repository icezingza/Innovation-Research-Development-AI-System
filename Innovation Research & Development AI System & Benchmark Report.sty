### PostgreSQL Schema & Alembic Migrations

Core relational schema for multi-tenant data isolation, with Row-Level Security enforced at the database level.

```bash
# Apply all migrations
alembic upgrade head

# Generate a new migration after schema changes
alembic revision --autogenerate -m "add_vertical_swarm_templates"

# Rollback one step
alembic downgrade -1
```

```sql
-- Multi-tenant isolation via Row-Level Security (RLS)
-- Applied in migration: 5a477e11f2af_add_tenant_schema_and_rls.py

CREATE TABLE hypothesis_records (
    id VARCHAR(36) PRIMARY KEY,
    tenant_id UUID REFERENCES tenants(id) NOT NULL,
    statement TEXT NOT NULL,
    confidence FLOAT DEFAULT 0.0 NOT NULL,
    topic TEXT NOT NULL,
    source VARCHAR(50) NOT NULL,
    session_id VARCHAR(36) DEFAULT '' NOT NULL,
    evidence JSONB,
    generation INTEGER DEFAULT 0 NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW() NOT NULL
);

ALTER TABLE hypothesis_records ENABLE ROW LEVEL SECURITY;

CREATE POLICY tenant_isolation_policy ON hypothesis_records
    USING (tenant_id = NULLIF(current_setting('app.current_tenant_id', true), '')::uuid);

-- FastAPI middleware sets per-request context:
-- SET LOCAL app.current_tenant_id = 'tenant-uuid';
-- This forces automatic filtering on ALL queries — even in the presence of application bugs.
```

